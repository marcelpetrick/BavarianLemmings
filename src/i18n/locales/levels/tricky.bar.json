{
  "level.tricky-01.name": "A gmahde Wiesn",
  "level.tricky-02.name": "A jeder sei Loch",
  "level.tricky-03.name": "D’Stiang auf d’Oim",
  "level.tricky-04.name": "Hob i scho herg’richt",
  "level.tricky-05.name": "Ned so hudln mim Klicka",

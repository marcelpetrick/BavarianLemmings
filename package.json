{
  "name": "bavarian-lemmings",
  "version": "0.1.56",
  "private": true,
  "description": "An homage to the 1991 DOS game Lemmings, running natively in the browser, with a Bavarian mode.",
  "license": "GPL-3.0-or-later",
  "author": "Marcel Petrick <mail@marcelpetrick.it>",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check . && stylelint \"src/**/*.css\"",
    "format": "prettier --write . && stylelint \"src/**/*.css\" --fix",
    "e2e": "playwright test",
    "screenshots": "vite build --logLevel warn && node scripts/screenshot.mjs",
    "levels:preview": "BL_RENDER_LEVELS=1 vitest run tests/tools/render-levels.test.ts",
    "pieces:gallery": "BL_RENDER_PIECES=1 BL_SCALE=2 vitest run tests/tools/render-levels.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "smol-toml": "1.9.1",
    "katex": "0.19.0"
  }
}
